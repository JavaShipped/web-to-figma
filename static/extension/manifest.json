{
  "manifest_version": 3,
  "name": "Web to Figma",
  "version": "0.1.0",
  "description": "Capture a page or element for the Web to Figma plugin: layout, styles, text, images and components.",
  "action": { "default_popup": "popup.html", "default_title": "Web to Figma" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],
  "commands": {
    "_execute_action": { "suggested_key": { "default": "Alt+Shift+F" } }
  }
}
